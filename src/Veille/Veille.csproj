<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Veille</AssemblyName>
    <RootNamespace>Veille</RootNamespace>
    <PackageId>Veille</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>Veille .NET SDK</Title>
    <Authors>Veille</Authors>
    <Company>Veille</Company>
    <Copyright>Copyright (c) 2026 Veille</Copyright>
    <Description>Official .NET SDK for the Veille fraud prevention API.</Description>
    <PackageTags>email-validation;fraud-prevention;vat-validation;ip-reputation;api;sdk;veille</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.veille.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/veilleio/veille-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Veille.Tests" />
  </ItemGroup>
</Project>
